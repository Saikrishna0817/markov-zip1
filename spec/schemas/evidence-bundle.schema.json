{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone",
    "version",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "milestone": {
      "const": "M0"
    },
    "version": {
      "const": "0.0.1"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "skipped",
        "not_applicable"
      ]
    },
    "commit": {
      "type": "string"
    },
    "archive_sha256": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
