{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "milestone",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "milestone": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "doi_or_url": {
            "type": "string"
          },
          "archive_sha256": {
            "type": "string"
          },
          "exact_mapping": {
            "type": "string"
          },
          "status": {
            "enum": [
              "approved",
              "proposed",
              "blocked"
            ]
          },
          "reviewer": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
